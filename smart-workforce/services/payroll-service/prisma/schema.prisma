generator client {
  provider = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["payroll"] 
}

model Payroll {
  id            String   @id @default(uuid())
  employeeId    String
  period        String   // e.g. "2025-10"
  totalHours    Float
  overtimeHours Float    @default(0)
  basePay       Float
  overtimePay   Float
  totalPay      Float
  status        status   @default(PENDING)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@schema("payroll")
  @@unique([employeeId, period], name: "employeeId_period")

}

enum status {
  PENDING
  COMPLETED
  APPROVED
  @@schema("payroll")
}

enum Role {
  ADMIN
  MANAGER
  SUPERVISOR
  EMPLOYEE
  @@schema("payroll")
}

enum SystemRole {
  SUPERADMIN
  USER
  @@schema("payroll")
}

model CachedUser {
  id               String      @id
  authUserId       String?     @unique
  email            String      @unique
  systemRole       SystemRole  @default(USER)
  organizationId   String?
  organizationRole Role?
  isActive         Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([organizationId])
  @@schema("payroll")
}
