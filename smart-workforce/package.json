{
  "name": "smart-workforce",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "services/*",
    "packages/*"
  ],
  "packageManager": "npm@11.5.2",
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "postinstall": "npm run build --workspaces --if-present",
    "docker:local:up": "docker compose -f docker-compose.local.yml up --build",
    "docker:local:down": "docker compose -f docker-compose.local.yml down"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/estree": "^1.0.8",
    "@types/json-schema": "^7.0.15",
    "eslint": "^9.33.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
